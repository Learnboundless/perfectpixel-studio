# PerfectPixel — API 키 환경변수 예시
# 이 파일을 .env 또는 .env.local로 복사한 뒤 사용할 프로바이더의 키만 채우세요.
# (앱 내 설정 화면에서 직접 입력해도 됩니다. 설정 파일이 환경변수보다 우선합니다.)
#
# .env / .env.local 은 .gitignore 에 의해 커밋되지 않습니다.

# Gemini (Google AI Studio) — 기본 프로바이더
GEMINI_API_KEY=
# GOOGLE_API_KEY 도 폴백으로 인식됩니다.

# OpenAI (GPT Image 2)
OPENAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# fal.ai
FAL_KEY=
# FAL_API_KEY 도 폴백으로 인식됩니다.

# BytePlus (ARK)
BYTEPLUS_API_KEY=
# ARK_API_KEY 도 폴백으로 인식됩니다.

# ZetaTechs (OpenAI Image compatible)
ZETATECHS_API_KEY=
# ZETA_API_KEY 도 폴백으로 인식됩니다.
# 기본 NewAPI 게이트웨이는 https://ent.zetatechs.com 입니다.
# 필요하면 ZETATECHS_BASE_URL=https://api.zetatechs.com 처럼 덮어쓸 수 있습니다.
ZETATECHS_BASE_URL=
ZETATECHS_TEXT_API_KEY=
ZETATECHS_TEXT_MODEL=

# 火山引擎方舟（Seedance 视频 / 文本 LLM）
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_VIDEO_MODEL=doubao-seedance-2-0-mini-260615
# 文本专用密钥可留空，应用会复用 VOLCENGINE_ARK_API_KEY。
VOLCENGINE_TEXT_API_KEY=
VOLCENGINE_TEXT_MODEL=glm-5-2-260617
